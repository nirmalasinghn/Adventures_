+int check_and_send_manual_alert(void)
+{
+    char *payload = NULL;
+    unsigned int read_ret;
+    int final_retval = 0;
+
+    payload = malloc(TRACKER_MANUAL_ALERT_MAX_LEN);
+    if (payload == NULL)
+    {
+        JIOTRACKER_LOG("payload alloc failed");
+        return -1;
+    }
+    memset(payload, 0, TRACKER_MANUAL_ALERT_MAX_LEN);
+
+    read_ret = tracker_read_manual_alert(payload, TRACKER_MANUAL_ALERT_MAX_LEN);
+    if (read_ret == 0)
+    {
+        JIOTRACKER_LOG("no pending manual alert to send");
+        JT_LOG_UPLOAD_I(JIOTKR_MQTT,"no pending manual alert to send");
+        free(payload);
+        payload = NULL;
+        return 0;
+    }
+
+    JIOTRACKER_LOG("manual alert nv read payload=%s", payload);
+    JT_LOG_UPLOAD_I(JIOTKR_MQTT,"manual alert nv read payload=%s", payload);
+
+    if(ewin_kmqtt_is_valid() == TRUE)
+    {
+        extern int mqtt_sf_protocol_write(char *data, int len, char *pubtopic);
+        final_retval = mqtt_sf_protocol_write(payload, strlen(payload), publish_topic);
+        JIOTRACKER_LOG("MQTT valid, sent manual alert payload=%s, ret=%d", payload, final_retval);
+        JT_LOG_UPLOAD_I(JIOTKR_MQTT,"MQTT valid, sent manual alert payload=%s, ret=%d", payload, final_retval);
+        if (final_retval == TRUE)
+        {
+            //tracker_clear_manual_alert();
+            set_jiotracker_mannual_shutdown_alert_constructed(1);
+        }
+    }
+    else
+    {
+        JIOTRACKER_LOG("MQTT not valid, cannot send manual alert");
+        JT_LOG_UPLOAD_E(JIOTKR_MQTT,"MQTT not valid, cannot send manual alert");
+    }
+    free(payload);
+    payload = NULL;
+    return final_retval;
+}
