+unsigned char tracker_write_manual_alert(const void *data, unsigned int len)
+{
+    char *safe_buf;
+    char *existing_buf;
+    unsigned int existing_len;
+    unsigned char write_ok;
+    if (data == NULL || len == 0 )
+    {
+        return 0;
+    }
+    if (len >= TRACKER_MANUAL_ALERT_MAX_LEN)
+    {
+        return 0;
+    }
+
+    existing_buf = (char *)ewin_malloc(TRACKER_MANUAL_ALERT_MAX_LEN);
+    if (existing_buf == NULL)
+    {
+        return 0;
+    }
+    existing_len = tracker_read_manual_alert(existing_buf, TRACKER_MANUAL_ALERT_MAX_LEN);
+    ewin_free(existing_buf);
+
+    if (existing_len > 0)
+    {
+        return 0;
+    }
+
+    safe_buf = (char *)ewin_malloc(TRACKER_MANUAL_ALERT_MAX_LEN);
+    if (safe_buf == NULL)
+    {
+        return 0;
+    }
+    memset(safe_buf, 0, TRACKER_MANUAL_ALERT_MAX_LEN);
+    memcpy(safe_buf, data, len);
+
+    write_ok = (tracker_write_nvram_file(TRACKER_STORE_MANUAL_ALERT_FILE, safe_buf, TRACKER_MANUAL_ALERT_MAX_LEN) == 1) ? 1 : 0;
+    ewin_free(safe_buf);
+    return write_ok;
+}
+
+unsigned int tracker_read_manual_alert(void *out_buf, unsigned int out_buf_size)
+{
+    int handle;
+    int read_ret;
+
+    if (out_buf == NULL || out_buf_size == 0)
+    {
+        return 0;
+    }
+
+    memset(out_buf, 0, out_buf_size);
+
+    handle = ewin_open_file(TRACKER_STORE_MANUAL_ALERT_FILE, EW_FILE_READ, NULL);
+    if (handle <= 0)
+    {
+        return 0;
+    }
+
+    read_ret = tracker_read_nvram_file(handle, out_buf, (int)out_buf_size);
+
+
+    if (read_ret != 1)
+    {
+        return 0;
+    }
+
+    ((char *)out_buf)[out_buf_size - 1] = '\0';
+
+    return (unsigned int)strlen((char *)out_buf);
+}
+
+void tracker_clear_manual_alert(void)
+{
+    ewin_delete_file(TRACKER_STORE_MANUAL_ALERT_FILE);
+}
